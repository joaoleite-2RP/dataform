config {
  type: "view",
  schema: "normalized",
  tags: ["normalized", "view"],
  description: "Modelo de Normalização (VIEW). Padroniza tipos, strings, datas e trata nulos sem custo de armazenamento físico."
}

/*
  ==============================================================================
  OBJETIVO DA NORMALIZAÇÃO (VIEW):
  ------------------------------------------------------------------------------
  - Padronizar tipos de dados (CAST / SAFE_CAST)
  - Padronizar textos (UPPER, TRIM) e formatos
  - Tratar valores nulos (COALESCE, IFNULL)
  - Criar campos auxiliares ou conversões de fuso horário
  - NÃO realiza deduplicação (não decide qual registro duplicado sobrevive)
  
  QUANDO USAR VIEW:
  - Transformação simples e leve
  - O volume de dados não justifica custo de armazenamento extra
  - A camada não será consultada repetidas vezes por múltiplos processos
  ==============================================================================
*/

SELECT
    -- Identificador e chaves lógicas
    CAST(id AS INT64) AS id_cliente,

    -- Padronização de strings
    UPPER(TRIM(nome)) AS nome_cliente,
    LOWER(TRIM(email)) AS email,
    
    -- Conversões seguras de valores numéricos
    SAFE_CAST(valor AS NUMERIC) AS valor,
    
    -- Padronização de datas e timestamps
    SAFE_CAST(data_nascimento AS DATE) AS dt_nascimento,
    SAFE_CAST(data_atualizacao AS TIMESTAMP) AS dth_atualizacao,
    SAFE_CAST(data_criacao AS TIMESTAMP) AS dth_insert,
    
    -- Tratamento de nulos com valores padrão
    COALESCE(TRIM(status), 'INATIVO') AS status_cliente,

    -- Metadado de auditoria do processamento
    CURRENT_TIMESTAMP() AS dth_processamento

FROM ${ref("tb_cliente_raw")}
